# Copied to .env by ./vigil.sh with random secrets filled in. Edit and run `./vigil.sh up` again.
VIGIL_ADMIN_USER=admin
VIGIL_ADMIN_PASSWORD=change-me
VIGIL_ENROLLMENT_TOKEN=change-me
# Address the console is published on. Use 0.0.0.0 to reach it from other machines.
VIGIL_BIND=127.0.0.1
VIGIL_PUBLIC_URL=https://localhost:8443
VIGIL_AGENT_HOSTNAME=docker-host
VIGIL_RETENTION_DAYS=30
# Free public threat-intel feeds (no API keys). Set 0 for air-gapped installs.
VIGIL_THREATINTEL=1
# Optional notifications can also be configured in the console under Settings.
